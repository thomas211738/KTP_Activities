# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local environment files and secrets
# Keep actual values on this machine or in EAS Environment Variables.
.env
.env.*
!.env.example

# Firebase / Google service account keys (never commit private keys)
serviceAccountKey.json
serviceAccountKey*.json
*firebase-adminsdk*.json
GoogleService-Info.plist.local
google-services.local.json

# Generated or team-private native configs
app.config.js
app.config.local.js
app.config.*.js

# Large reproducible build directories (these are regenerated)
ios/build/
ios/Pods/
android/.gradle/
android/build/

# typescript
*.tsbuildinfo

# Local device-only configuration overrides (for personal Apple team builds, different bundle ID, no push entitlement)
# These must never be committed.
app.config.js
app.config.local.js
app.config.*.js
app.config.local.*
ios/.xcode.env.local
