# KTPActivities - .env.example (SAFE TO COMMIT)
#
# The app now supports environment-specific files loaded by react-native-dotenv.
# The active file is chosen at build time based on APP_ENV (or NODE_ENV).
#
# Supported files (in priority order):
#   .env.production   → used when APP_ENV=production
#   .env.development  → used for local dev / simulator
#   .env              → fallback
#
# How to select the environment when building:
#   APP_ENV=production npx expo run:ios --configuration Release
#   APP_ENV=production eas build --profile production --platform ios
#
# After changing any .env.* file you MUST clean-rebuild for native code to pick up the values:
#   npx expo prebuild --clean
#
# DO NOT commit real .env, .env.production, or service account keys.

# -----------------------------------------------------------------------------
# Google Sign-In client IDs (these are public, safe to commit)
# -----------------------------------------------------------------------------
GOOGLE_AUTH_IOS_CLIENT_ID=771690908503-33ut1klakba9qfhgkensqrub49c1pe2d.apps.googleusercontent.com
GOOGLE_AUTH_ANDROID_CLIENT_ID=771690908503-nhekmo5q19qheuon33pb68ilo9ot6sh7.apps.googleusercontent.com
WEB_CLIENT_ID=771690908503-quj8ttpuuibuumef934jq5ojrk58nc86.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Backend base URL  ← #1 MOST IMPORTANT VARIABLE
# -----------------------------------------------------------------------------
# Development / simulator:
BACKEND_URL=http://localhost:5001

# -----------------------------------------------------------------------------
# Production BACKEND_URL (matches remote repo production setup)
# -----------------------------------------------------------------------------
# The remote repo deploys the Express app as a Firebase Function named "api":
#   firebase deploy --only functions:api
#   export const api = onRequest(..., app)   // in backend/index.js
#
# Therefore the anticipated production URL is:
#   https://us-central1-kappa-theta.cloudfunctions.net/api
#
# All client calls do `${BACKEND_URL}/users`, `/events`, `/alerts`, `/photo2`, etc.
# With the URL above they resolve to /api/users, /api/events, ...
#
# If you deploy the backend elsewhere (Render, custom domain, etc.) use the
# base URL where the Express routes are mounted at the root.
#
# Localhost / 10.x / 192.168.x are rejected for production builds.
BACKEND_URL=https://us-central1-kappa-theta.cloudfunctions.net/api

# -----------------------------------------------------------------------------
# Direct Google Calendar (needed to stop the 403 error you saw)
# -----------------------------------------------------------------------------
# GOOGLE_CALENDAR_ID=primary
# DEFAULT_POSITION=3
# GOOGLE_CALENDAR_API_KEY=AIzaSy...   # Restricted browser key (Google Cloud → Credentials → API key, restrict to Calendar API + iOS/Android bundle IDs)

# -----------------------------------------------------------------------------
# Firebase web config (client-side keys - these are public, not secrets)
# -----------------------------------------------------------------------------
# These get baked into the app. Production builds will hard-fail without them.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Notes:
# - Create .env.development and .env.production from this example for real use.
# - Never put real secrets in files that get committed.
# - Production builds enforce real backend URL + real Firebase keys.

# -----------------------------------------------------------------------------
# How APP_ENV (dev vs production) is decided
# -----------------------------------------------------------------------------
# The app uses a central resolver (in app.config.ts + babel.config.js + firebaseConfig.js).
#
# Local (no EAS upload needed):
#   npx expo run:ios                              → development   (loads .env.development)
#   npx expo run:ios --configuration Release      → production    (loads .env.production / .env)
#   APP_ENV=production npx expo run:ios --configuration Release
#
# EAS builds (recommended for real releases):
#   eas build --profile development   → development
#   eas build --profile preview       → production
#   eas build --profile production    → production
#
# You can also set APP_ENV + real values as Environment Variables in the
# Expo project dashboard (they win over local .env files).
#
# The resolved value is logged at build time:
#   [app.config] Resolved APP_ENV="production" (isProduction=true)

# -----------------------------------------------------------------------------
# Direct Google Calendar (client-side fetch fallback)
# -----------------------------------------------------------------------------
# Used by app/utils/publicCalendar.ts.
# Google now requires an API key → 403 error without it (you saw this).
#
# Recommended: Store calendarId + defaultPosition in Firestore `calendarTokens/main`.
# Then you mainly need GOOGLE_CALENDAR_API_KEY.
#
# GOOGLE_CALENDAR_ID=primary
# DEFAULT_POSITION=3
# GOOGLE_CALENDAR_API_KEY=AIzaSy...   # Create restricted key with Calendar API enabled

# -----------------------------------------------------------------------------
# WHAT YOU ACTUALLY NEED TO SET (clean list)
# -----------------------------------------------------------------------------

# 1. BACKEND_URL (MOST IMPORTANT)
# Local dev:
BACKEND_URL=http://localhost:5001
# Production (real public URL):
# BACKEND_URL=https://your-real-backend.com

# 2. Firebase web config (client keys - these get baked into the app)
# Production builds will crash without valid values.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# 3. Direct Google Calendar (to stop the 403 "unregistered callers" error)
# GOOGLE_CALENDAR_API_KEY is now basically required.
# GOOGLE_CALENDAR_ID + DEFAULT_POSITION are fallbacks if Firestore config is missing.
# GOOGLE_CALENDAR_ID=primary
# DEFAULT_POSITION=3
# GOOGLE_CALENDAR_API_KEY=AIzaSy...   # Restricted browser key only (Calendar API + your app bundle IDs)

# 4. Google Sign-In (already correct - safe to leave as-is)
GOOGLE_AUTH_IOS_CLIENT_ID=771690908503-33ut1klakba9qfhgkensqrub49c1pe2d.apps.googleusercontent.com
GOOGLE_AUTH_ANDROID_CLIENT_ID=771690908503-nhekmo5q19qheuon33pb68ilo9ot6sh7.apps.googleusercontent.com
WEB_CLIENT_ID=771690908503-quj8ttpuuibuumef934jq5ojrk58nc86.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# WHERE TO PUT THE REAL VALUES
# -----------------------------------------------------------------------------
# Local development + local Release testing:
#   Edit: .env.development   and/or   .env   and/or   .env.production
#
# Real production builds (EAS --profile production):
#   Set in Expo Dashboard → Project → Build → Environment variables
#   (for the "production" profile, and "preview" if you use it)
#   Dashboard values override .env files on EAS builds.
