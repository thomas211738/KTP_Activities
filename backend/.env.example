# backend/.env.example
# Copy to .env and fill real values.
# Safe to commit this example file.

# Port the Express server listens on
APP_PORT=5000

# Firebase Admin (project + storage are required for admin SDK init)
GOOGLE_FIREBASE_PROJECT_ID=kappa-theta
GOOGLE_FIREBASE_STORAGE_BUCKET=kappa-theta.appspot.com

# These are the web config values (from Firebase Console → Project settings → General → Your apps → Web)
# They are not strictly needed after switching to firebase-admin, but kept for compatibility.
GOOGLE_FIREBASE_API_KEY=AIzaSyD4i-P_we79TljSDxvuDguqEQOgYZ_HCX0
GOOGLE_FIREBASE_AUTH_DOMAIN=kappa-theta.firebaseapp.com
GOOGLE_FIREBASE_MESSAGING_SENDER_ID=771690908503
GOOGLE_FIREBASE_APP_ID=1:771690908503:web:386727787dce2592568c12

# -----------------------------------------------------------------------------
# Credentials for Firestore / Storage access (one of these is required)
# -----------------------------------------------------------------------------
# Option A (recommended for local dev): place a downloaded service account key here
#   1. Firebase Console → Project settings → Service accounts → Generate new private key
#   2. Save the JSON as: backend/serviceAccountKey.json
#   The code will auto-detect it.

# Option B: set the env var to point at a key file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-key.json

# Option C: gcloud auth application-default login   (then no file needed)

# -----------------------------------------------------------------------------
# Other (only needed if you run the upload scripts or email route)
# -----------------------------------------------------------------------------
# mongoDBURL=...
# EMAIL_USER=...
# EMAIL_PASS=...

# -----------------------------------------------------------------------------
# Google Calendar webhook (Cloud Function) — multi-calendar + relaxed Position
# -----------------------------------------------------------------------------
# PRIMARY SOURCE: Firestore document  calendarTokens/main
#   This is the single source of truth in production.
#   Store the config as a direct map, under "config", or as a JSON string in "configJson".
#
# Example direct map you can put in Firestore:
# {
#   "personal": { "calendarId": "primary", "defaultPosition": 3 },
#   "eboard":   { "calendarId": "eboard-ktp@group.calendar.google.com", "defaultPosition": 3 }
# }
#
# ENV VARS BELOW ARE ONLY A FALLBACK
# (used when calendarTokens/main does not exist or is empty — mostly for local dev / first-time setup)
#
# You do NOT need to keep CALENDAR_CONFIGS in .env once the Firestore document is populated.
#
# Single calendar fallback:
# GOOGLE_CALENDAR_ID=primary
# DEFAULT_POSITION=3
#
# Multiple calendars fallback:
# CALENDAR_CONFIGS={"personal":{"calendarId":"primary","defaultPosition":3},"eboard":{"calendarId":"eboard-ktp@group.calendar.google.com","defaultPosition":3}}

# -----------------------------------------------------------------------------
# Google Calendar Webhook URL (STATIC - defined in backend/config.js)
# -----------------------------------------------------------------------------
# The webhook URL is now a static value in backend/config.js.
# Default for this project:
#   https://us-central1-kappa-theta.cloudfunctions.net/calendarWebhook
#
# This URL does NOT change when you switch Google Calendars (personal ↔ eboard etc.).
# You only need to set this override if you deploy the function somewhere else.
#
# CALENDAR_WEBHOOK_URL=https://us-central1-kappa-theta.cloudfunctions.net/calendarWebhook
#
# Scripts now import the value from config.js. You can still override at runtime:
#   CALENDAR_WEBHOOK_URL=... node registerCalendarWatch.js personal

# Never commit real .env or serviceAccountKey*.json
